# AeroReady — Root Environment Example
# Copy this to .env and fill in any values you wish to override.
# The backend .env.example has the full list of backend variables.

# ── Backend (src/backend/.env.example) ────────────────────────────────────────
# DATABASE_URL=sqlite:///app.db           (default — no change needed for local dev)
# FLASK_ENV=development
# FLASK_DEBUG=true
# MISSION_DURATION_CYCLES=30
# MODEL_DIR=ai_engine
# DATA_DIR=data

# ── Frontend (src/frontend/.env.example) ──────────────────────────────────────
# VITE_API_URL=http://127.0.0.1:5000/api/v1   (default — no change needed for local dev)

# ── Groq LLM (Optional Reasoning Layer) ───────────────────────────────────────
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_BASE_URL=https://api.groq.com/openai/v1
