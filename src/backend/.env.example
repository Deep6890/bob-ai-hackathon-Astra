# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/mission_readiness_db

# Flask settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key

FRONTEND_ORIGIN=http://localhost:3000
MISSION_DURATION_CYCLES=30

# Paths can be absolute or relative to the backend folder
MODEL_DIR=ai_engine
DATA_DIR=data

# Groq LLM configuration for Copilot (optional)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
